# Channel Factory — environment

# LLM (optional). Without it, script/metadata fall back to deterministic generation.
ANTHROPIC_API_KEY=
FACTORY_LLM_MODEL=claude-sonnet-4-6

# YouTube direct-post (optional). Without it, YouTube falls back to the assisted queue.
# Obtain via an OAuth refresh flow with scope youtube.upload (ops concern).
FACTORY_YT_ACCESS_TOKEN=

# Where generated artifacts go (default: ./out)
FACTORY_DATA_DIR=

# Log level: debug | info | warn | error (default: info)
FACTORY_LOG_LEVEL=info
