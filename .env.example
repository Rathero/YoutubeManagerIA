# Channel Factory — environment
# Every provider falls back to a deterministic/stub path when its key is absent,
# so the whole pipeline runs offline with no credentials.

# ── Text / LLM (script + metadata + storyboard + genesis) ──────────────────────
# Selected per-channel via script.provider.name (anthropic|openai|gemini|auto).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides:
FACTORY_ANTHROPIC_MODEL=claude-sonnet-4-6
FACTORY_OPENAI_MODEL=gpt-4o
FACTORY_GEMINI_MODEL=gemini-2.5-flash

# ── Voice / TTS (most realistic narration) ─────────────────────────────────────
# Selected per-channel via voice.provider (elevenlabs|openai|google|stub).
ELEVENLABS_API_KEY=
# OpenAI TTS reuses OPENAI_API_KEY; Google TTS reuses GEMINI_API_KEY.

# ── Generative video (Veo / Sora / Runway) ─────────────────────────────────────
# Selected per-channel via video.provider. Veo/Google TTS use GEMINI_API_KEY.
RUNWAY_API_KEY=
# Optional model/endpoint overrides:
FACTORY_VEO_MODEL=veo-3.1-generate-001
FACTORY_SORA_MODEL=sora-2
FACTORY_RUNWAY_MODEL=gen4_turbo

# ── Publishing ─────────────────────────────────────────────────────────────────
# YouTube direct-post (OAuth access token w/ youtube.upload). Else assisted queue.
# Also used (best-effort) for custom thumbnail + subtitle upload.
FACTORY_YT_ACCESS_TOKEN=

# ── Own distribution (newsletter / Telegram) ───────────────────────────────────
BUTTONDOWN_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cross-posting (X / Bluesky / LinkedIn) ─────────────────────────────────────
X_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# ── Free stock B-roll (data-card backgrounds) ──────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── Ops alerts (run success/failure) ───────────────────────────────────────────
DISCORD_WEBHOOK_URL=
# FACTORY_ALERT_ON_SUCCESS=1   # also alert on successful runs (failures always alert)

# ── Captions alignment (Whisper, optional) ─────────────────────────────────────
# OpenAI-compatible transcription endpoint (local faster-whisper/Speaches, or OpenAI).
FACTORY_WHISPER_URL=http://localhost:8000/v1
FACTORY_WHISPER_MODEL=Systran/faster-whisper-base

# ── Infra (optional; default is JSON store + in-process run) ───────────────────
# FACTORY_STORE=postgres  +  DATABASE_URL=postgres://user:pass@host:5432/db
FACTORY_STORE=json
DATABASE_URL=
# BullMQ worker (factory worker): REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# ── LOCAL models ($0 inference, self-hosted) ───────────────────────────────────
# Text: any OpenAI-compatible server (Ollama / LM Studio / llama.cpp / vLLM).
FACTORY_LOCAL_LLM_URL=http://localhost:11434/v1
FACTORY_LOCAL_LLM_MODEL=qwen3
# FACTORY_LOCAL_LLM=1   # let provider.name "auto" fall back to local when no cloud key
# Voice: OpenAI-compatible local TTS (Kokoro / Speaches / LocalAI).
FACTORY_LOCAL_TTS_URL=http://localhost:8880/v1
# Voice: Piper binary (provider: piper; set voice.model_path in the channel config).
PIPER_BIN=piper
# Image + Video: ComfyUI (FLUX/SDXL images, Wan/LTX/Hunyuan video).
FACTORY_COMFYUI_URL=http://localhost:8188

# ── Render ─────────────────────────────────────────────────────────────────────
# Point at a Remotion project entry to enable the remotion render engine.
FACTORY_REMOTION_ENTRY=

# ── SaaS / multi-tenant ────────────────────────────────────────────────────────
# Isolate data (out/_tenants/<t>) and configs (tenants/<t>/config) per tenant.
FACTORY_TENANT=
# Optional token gate for the web dashboard API.
FACTORY_DASHBOARD_TOKEN=

# ── Misc ───────────────────────────────────────────────────────────────────────
FACTORY_DATA_DIR=
FACTORY_LOG_LEVEL=info
