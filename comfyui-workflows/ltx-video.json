{
  "_README": "LTX-Video text→video (best-effort). Needs a recent ComfyUI with native LTXV nodes + the files from `npm run setup:comfyui -- <model> video-ltx`. If your ComfyUI version differs, build the graph in ComfyUI and re-export (Save API Format), keeping the tokens {{PROMPT}} {{NEGATIVE}} {{WIDTH}} {{HEIGHT}} {{SECONDS}} {{FPS}} {{SEED}}.",
  "10": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "ltx-video-2b-v0.9.5.safetensors" } },
  "11": { "class_type": "CLIPLoader", "inputs": { "clip_name": "t5xxl_fp8_e4m3fn.safetensors", "type": "ltxv" } },
  "12": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{PROMPT}}", "clip": ["11", 0] } },
  "13": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{NEGATIVE}}", "clip": ["11", 0] } },
  "14": { "class_type": "EmptyLTXVLatentVideo", "inputs": { "width": {{WIDTH}}, "height": {{HEIGHT}}, "length": {{SECONDS}}, "batch_size": 1 } },
  "15": { "class_type": "LTXVConditioning", "inputs": { "positive": ["12", 0], "negative": ["13", 0], "frame_rate": {{FPS}} } },
  "16": {
    "class_type": "KSampler",
    "inputs": { "seed": {{SEED}}, "steps": 30, "cfg": 3.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1,
      "model": ["10", 0], "positive": ["15", 0], "negative": ["15", 1], "latent_image": ["14", 0] }
  },
  "17": { "class_type": "VAEDecode", "inputs": { "samples": ["16", 0], "vae": ["10", 2] } },
  "18": { "class_type": "SaveAnimatedWEBP", "inputs": { "filename_prefix": "factory-ltx", "fps": {{FPS}}, "lossless": false, "quality": 85, "method": "default", "images": ["17", 0] } }
}
