{
  "name": "channel-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Agnostic factory to create and operate faceless automated channels (YouTube/TikTok/Instagram) from a niche definition.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "factory": "./dist/ops/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "factory": "tsx src/ops/cli.ts",
    "quickstart": "bash scripts/quickstart.sh",
    "quickstart:win": "powershell -ExecutionPolicy Bypass -File scripts/quickstart.ps1",
    "demo": "tsx src/ops/cli.ts run luz-es --date 2026-06-21",
    "ui": "tsx src/ops/cli.ts dashboard --open",
    "verify": "bash scripts/verify.sh",
    "doctor": "tsx src/ops/cli.ts doctor",
    "setup:local": "bash scripts/setup-local.sh",
    "setup:local:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "local:up": "docker compose -f docker-compose.local.yml up -d ollama kokoro",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "stack:up": "docker compose up -d --build",
    "stack:up:ai": "docker compose --profile ai up -d --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
