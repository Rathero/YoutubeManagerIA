{
  "name": "channel-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Agnostic factory to create and operate faceless automated channels (YouTube/TikTok/Instagram) from a niche definition.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "factory": "./dist/ops/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "factory": "tsx src/ops/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
